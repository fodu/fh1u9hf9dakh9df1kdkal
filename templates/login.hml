{% extends "navbar.html" %}
{% block top %}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Login - Doxbin</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='legacy/index.css') }}">
    <link rel="stylesheet" href="{{ url_for('static', filename='others/bootstrap.css') }}">
</head>
<body>
{% endblock %}

{% block bottom %}
<div class="container" style="margin-top: 100px;">
    <div class="col-md-4 col-md-offset-4">
        <h3 style="color: white; text-align: center;">Login</h3>
        {% with messages = get_flashed_messages(with_categories=true) %}
            {% if messages %}
                {% for category, message in messages %}
                    <div class="alert alert-{{ category }}">{{ message }}</div>
                {% endfor %}
            {% endif %}
        {% endwith %}
        <form method="POST">
            <div class="form-group">
                <label style="color: white;">Username</label>
                <input type="text" name="username" class="form-control" required>
            </div>
            <div class="form-group">
                <label style="color: white;">Password</label>
                <input type="password" name="password" class="form-control" required>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Entrar</button>
        </form>
        <p style="text-align: center; margin-top: 10px; color: white;">
            Não tem conta? <a href="{{ url_for('register') }}" style="color: #00AAFF;">Registre-se aqui</a>
        </p>
    </div>
</div>
</body>
</html>
{% endblock %}
